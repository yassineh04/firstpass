root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official

# Markdown uses trailing spaces for line breaks.
[*.md]
trim_trailing_whitespace = false

# Diff fixtures (eval cases, tests): whitespace is significant.
[*.{patch,diff}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.bat]
end_of_line = crlf
