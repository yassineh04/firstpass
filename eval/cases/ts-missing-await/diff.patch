diff --git a/frontend/src/api/profile.ts b/frontend/src/api/profile.ts
index 4b1f0c3..d8e2a65 100644
--- a/frontend/src/api/profile.ts
+++ b/frontend/src/api/profile.ts
@@ -3,4 +3,11 @@ import type { Profile } from './types'
 export async function loadProfile(id: string): Promise<Profile> {
   const response = await fetch(`/api/profiles/${id}`)
   return response.json()
 }
+
+export async function saveProfile(profile: Profile): Promise<void> {
+  const response = fetch(`/api/profiles/${profile.id}`, { method: 'PUT', body: JSON.stringify(profile) })
+  if (!response.ok) {
+    throw new Error('Could not save the profile')
+  }
+}
