# Local configuration. Copy this file to .env and fill in the values.
# .env is ignored by git: never commit real values. Production secrets live in AWS SSM.

# LLM provider used locally: fake | ollama | gemini | groq
FIRSTPASS_LLM_PROVIDER=fake
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1/
# Model used with --provider ollama; it must be pulled in Ollama first.
OLLAMA_MODEL=

# Development GitHub App (see docs/github-app-setup.md)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
# Path to the PKCS#8 private key, stored outside the repository folder.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Only needed for the dashboard sign-in (phase 4).
GITHUB_CLIENT_SECRET=
SMEE_URL=

# DynamoDB Local (docker compose up -d). It accepts any credentials made of letters
# and digits, and any Region code: these placeholders are not real AWS keys.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=firstpass
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Signing key for dashboard session tokens (phase 4).
FIRSTPASS_JWT_SIGNING_KEY=
